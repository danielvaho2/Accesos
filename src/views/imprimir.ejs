<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Impresión - Prueba de Accesos</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="stylesheet" href="/print.css">
</head>
<body onload="window.print()">
  <h1>Prueba de Accesos</h1>
  <div class="subtitle">Detalle de jornada y horas extra</div>

  <div class="filters">
    <% if (fechaInicio && fechaFin) { %>
      <span><strong>Rango:</strong> <%= fechaInicio %> al <%= fechaFin %></span>
    <% } %>
    <% if (nombre) { %>
      <span><strong>Nombre:</strong> <%= nombre %></span>
    <% } %>
  </div>

  <table>
    <thead>
      <tr>
        <th>Nombre</th>
        <th>Fecha</th>
        <th>Entrada</th>
        <th>Salida</th>
        <th>Horas laboradas</th>
        <th>Extra diurna</th>
        <th>Extra nocturna</th>
      </tr>
    </thead>
    <tbody>
      <% if (usuarios.length === 0) { %>
        <tr>
          <td colspan="7">No hay registros para los filtros seleccionados.</td>
        </tr>
      <% } %>

      <% usuarios.forEach(user => { %>
        <tr>
          <td><%= user.Nombre %></td>
          <td><%= user.Dia %></td>
          <td><%= user.Hora_entrada %></td>
          <td><%= user.Hora_salida %></td>
          <td><%= user.horas_laboradas %></td>
          <td><%= user.extra_diurna_total %></td>
          <td><%= user.extra_nocturna %></td>
        </tr>
      <% }) %>

      <% if (hacerSumatoria && totales) { %>
        <tr class="totals-row">
          <td colspan="4">TOTAL</td>
          <td><%= totales.horas %></td>
          <td><%= totales.extra_diurna %></td>
          <td><%= totales.extra_nocturna %></td>
        </tr>
      <% } %>
    </tbody>
  </table>

  <div class="footer">
    <span>Registros: <strong><%= usuarios.length %></strong></span>
    <span>Generado el <%= new Date().toLocaleString("es-ES") %></span>
  </div>
</body>
</html>

