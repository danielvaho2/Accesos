<!--
  src/views/index.ejs
  Plantilla EJS que muestra la tabla de empleados y el formulario
  para subir un archivo Excel.

  Variables esperadas desde el servidor:
  - `usuarios`: array de objetos con campos `Nombre`, `Dia`, `Hora_entrada`,
    `Hora_salida`, `horas_laboradas`, `extra_diurna_total`, `extra_nocturna`.
-->
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Prueba de Accesos</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <!-- Bootstrap 5 -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-light">

  <header class="container py-5">

    <div class="text-center mb-4">
      <h1 class="display-4 fw-bold">Prueba de Accesos</h1>
      <p class="text-muted">Control de registros de empleados</p>
    </div>

    <!-- Tabla -->
    <div class="card shadow mb-5">
      <div class="card-header bg-primary text-white">
        <h4 class="mb-0">Empleados</h4>
      </div>
      <div class="card-body table-responsive">

        <table class="table table-striped table-bordered table-hover align-middle text-center">
          <thead class="table-dark">
            <tr>
              <th>Nombre</th>
              <th>Fecha</th>
              <th>Entrada</th>
              <th>Salida</th>
              <th>Horas Laboradas</th>
              <th>Extra Diurna</th>
              <th>Extra Nocturna</th>
            </tr>
          </thead>
          <tbody>
            <% usuarios.forEach(user => { %>
              <tr>
                <td><%= user.Nombre %></td>
                <td><%= user.Dia %></td>
                <td><%= user.Hora_entrada %></td>
                <td><%= user.Hora_salida %></td>
                <td><%= user.horas_laboradas %></td>
                <td><%= user.extra_diurna_total %></td>
                <td><%= user.extra_nocturna %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>

      </div>
    </div>

    <!-- Subir archivo -->
    <div class="card shadow">
      <div class="card-header bg-success text-white">
        <h4 class="mb-0">Subir Excel de empleados</h4>
      </div>
      <div class="card-body">
        <form action="/upload" method="POST" enctype="multipart/form-data" class="row g-3 align-items-center">
          <div class="col-md-8">
            <input class="form-control" type="file" name="file" accept=".xlsx" required>
          </div>
          <div class="col-md-4 d-grid">
            <button class="btn btn-success" type="submit">
              📤 Subir Excel
            </button>
          </div>
        </form>
      </div>
    </div>

  </header>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
