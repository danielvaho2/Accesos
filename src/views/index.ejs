<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Prueba de Accesos</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <link rel="stylesheet" href="/styles.css">
</head>

<body>
  <div class="container">
    <header>
      <h1>Prueba de Accesos</h1>
      <p>Control de registros de empleados</p>
    </header>

    <!-- FILTRO -->
    <section class="card">
      <div class="card-header">
        <h2>Filtrar registros</h2>
        <small>Selecciona un rango de fechas y/o un nombre para buscar.</small>
      </div>
      <div class="card-body">
        <form method="GET" action="/">
          <div class="filters-row">
            <div class="field">
              <label for="fechaInicio">Desde</label>
              <input 
                id="fechaInicio"
                type="date"
                name="fechaInicio"
                value="<%= typeof fechaInicio !== 'undefined' ? fechaInicio : '' %>"
              >
            </div>

            <div class="field">
              <label for="fechaFin">Hasta</label>
              <input
                id="fechaFin"
                type="date"
                name="fechaFin"
                value="<%= typeof fechaFin !== 'undefined' ? fechaFin : '' %>"
              >
            </div>

            <div class="field">
              <label for="nombre">Nombre</label>
              <input
                id="nombre"
                type="text"
                name="nombre"
                placeholder="Buscar empleado..."
                value="<%= typeof nombre !== 'undefined' ? nombre : '' %>"
              >
            </div>

            <div class="field" style="align-self: flex-end;">
              <div class="actions-row">
                <a href="/" class="btn btn-secondary">Limpiar</a>
                <button type="submit" class="btn btn-primary">
                  🔍 Buscar
                </button>
              </div>
            </div>
          </div>

          <div class="filters-summary">
            <span>
              Registros encontrados: <strong><%= usuarios.length %></strong>
            </span>
<!--
            <% if (hacerSumatoria && totales) { %>
              <span>
                Totales visibles — Horas: <strong><%= totales.horas %></strong>,
                Extra diurna: <strong><%= totales.extra_diurna %></strong>,
                Extra nocturna: <strong><%= totales.extra_nocturna %></strong>
              </span>
            <% } else { %>
              <span>
                Para ver sumas totales aplica un rango de fechas y un nombre.
              </span>
            <% } %>
-->
          </div>
        </form>
      </div>
    </section>

    <!-- TABLA -->
    <section class="card">
      <div class="card-header">
        <h2>Resultados</h2>
        <small>Listado detallado de accesos por día.</small>
      </div>
      <div class="card-body">
        <div class="table-wrapper">
          <table>
            <thead>
              <tr>
                <th>Nombre</th>
                <th>Fecha</th>
                <th>Entrada</th>
                <th>Salida</th>
                <th>Horas laboradas</th>
                <th>Extra diurna</th>
                <th>Extra nocturna</th>
              </tr>
            </thead>
            <tbody>
              <% if (usuarios.length === 0) { %>
                <tr>
                  <td colspan="7" class="text-muted">
                    No hay registros disponibles para los filtros seleccionados.
                  </td>
                </tr>
              <% } %>

              <% usuarios.forEach(user => { %>
                <tr>
                  <td><%= user.Nombre %></td>
                  <td><%= user.Dia %></td>
                  <td><%= user.Hora_entrada %></td>
                  <td><%= user.Hora_salida %></td>
                  <td><%= user.horas_laboradas %></td>
                  <td><%= user.extra_diurna_total %></td>
                  <td><%= user.extra_nocturna %></td>
                </tr>
              <% }) %>

              <% if (hacerSumatoria && totales) { %>
                <div >
                <tr class="totals-row" style=" background: #fff3cd;">
                  <td colspan="4">TOTAL</td>
                  <td><%= totales.horas %></td>
                  <td><%= totales.extra_diurna %></td>
                  <td><%= totales.extra_nocturna %></td>
                </tr>
              </div>
              <% } %>

             
            </tbody>
          </table>
        </div>
      

        <% if (hacerSumatoria && totales) { %>
          <div class="table-footer">
            <span>Vista actual: <strong><%= usuarios.length %></strong> registros.</span>
            <form method="GET" action="/imprimir" style="margin:0;">
              <input type="hidden" name="fechaInicio" value="<%= typeof fechaInicio !== 'undefined' ? fechaInicio : '' %>">
              <input type="hidden" name="fechaFin" value="<%= typeof fechaFin !== 'undefined' ? fechaFin : '' %>">
              <input type="hidden" name="nombre" value="<%= typeof nombre !== 'undefined' ? nombre : '' %>">
              <button type="submit" class="btn btn-ghost">
                🖨 Imprimir tabla
              </button>
            </form>
          </div>
        <% } %>
      </div>
    </section>

    <!-- SUBIR EXCEL -->
    <section class="card">
      <div class="card-header">
        <h2>Subir Excel de empleados</h2>
        <small>Importa un archivo .xlsx para actualizar los datos.</small>
      </div>
      <div class="card-body">
        <form action="/upload" method="POST" enctype="multipart/form-data">
          <div class="filters-row">
            <div class="field" style="grid-column: span 3;">
              <label for="file">Archivo XLSX</label>
              <input id="file" type="file" name="file" accept=".xlsx" required>
            </div>
            <div class="field" style="align-self: flex-end;">
              <button type="submit" class="btn btn-primary">
                ⬆️ Subir Excel
              </button>
            </div>
          </div>
          <p class="upload-hint">
            Formato esperado: columnas <strong>Nombre</strong>, <strong>Dia</strong>, <strong>Hora_entrada</strong>, <strong>Hora_salida</strong>.
          </p>
        </form>
      </div>
    </section>
  </div>

  <script>
    // Espacio para pequeños comportamientos si los necesitas en el futuro
  </script>
</body>
</html>