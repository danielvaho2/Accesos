<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Prueba de Accesos</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <!-- Bootstrap 5 -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-light">

  <header class="container py-5">

    <div class="text-center mb-4">
      <h1 class="display-4 fw-bold">Prueba de Accesos</h1>
      <p class="text-muted">Control de registros de empleados</p>
    </div>

    <!-- FILTRO -->
    <div class="card shadow mb-4">
      <div class="card-header bg-dark text-white">
        <h4 class="mb-0">Filtrar Registros</h4>
      </div>
      <div class="card-body">
        <form method="GET" action="/" class="row g-3 align-items-end">

          <div class="col-md-3">
            <label class="form-label">Desde</label>
            <input 
              type="date" 
              name="fechaInicio" 
              class="form-control"
              value="<%= typeof fechaInicio !== 'undefined' ? fechaInicio : '' %>"
            >
          </div>

          <div class="col-md-3">
            <label class="form-label">Hasta</label>
            <input 
              type="date" 
              name="fechaFin" 
              class="form-control"
              value="<%= typeof fechaFin !== 'undefined' ? fechaFin : '' %>"
            >
          </div>

          <div class="col-md-3">
            <label class="form-label">Nombre</label>
            <input 
              type="text" 
              name="nombre" 
              class="form-control"
              placeholder="Buscar empleado..."
              value="<%= typeof nombre !== 'undefined' ? nombre : '' %>"
            >
          </div>

          <div class="col-md-3 bg-light ">
            <button class="btn btn-primary" type="submit">
              🔎 
            </button>
          
            <a href="/" class="btn btn-secondary">
              Limpiar
            </a>
         
          </div>


        </form>
      </div>
    </div>


    <!-- TABLA -->
    <div class="card shadow mb-5">
  <div class="card-header bg-primary text-white">
    <h4 class="mb-0">Resultados</h4>
  </div>
  <div class="card-body table-responsive">

    <table class="table table-striped table-bordered table-hover align-middle text-center">
      <thead class="table-dark">
        <tr>
          <th>Nombre</th>
          <th>Fecha</th>
          <th>Entrada</th>
          <th>Salida</th>
          <th>Horas Laboradas</th>
          <th>Extra Diurna</th>
          <th>Extra Nocturna</th>
        </tr>
      </thead>

      <tbody>

        <% if (usuarios.length === 0) { %>
          <tr>
            <td colspan="7" class="text-muted">
              No hay registros disponibles
            </td>
          </tr>
        <% } %>

        <% usuarios.forEach(user => { %>
          <tr>
            <td><%= user.Nombre %></td>
            <td><%= user.Dia %></td>
            <td><%= user.Hora_entrada %></td>
            <td><%= user.Hora_salida %></td>
            <td><%= user.horas_laboradas %></td>
            <td><%= user.extra_diurna_total %></td>
            <td><%= user.extra_nocturna %></td>
          </tr>
        <% }) %>

     <% if (hacerSumatoria && totales) { %>
  <tr class="table-warning fw-bold">
    <td colspan="4">TOTAL</td>
    <td><%= totales.horas %></td>
    <td><%= totales.extra_diurna %></td>
    <td><%= totales.extra_nocturna %></td>
  </tr>

  <!-- Fila del botón -->
  <tr>
    <td colspan="7" class="text-end">
      <button class="btn btn-primary">Imprimir</button>
    </td>
  </tr>
<% } %>
 

      </tbody>
    </table>

  </div>
</div>


    <!-- SUBIR EXCEL -->
    <div class="card shadow">
      <div class="card-header bg-primary text-white">
        <h4 class="mb-0">Subir Excel de empleados</h4>
      </div>
      <div class="card-body">
        <form action="/upload" method="POST" enctype="multipart/form-data" class="row g-3 align-items-center">
          <div class="col-md-8">
            <input class="form-control" type="file" name="file" accept=".xlsx" required>
          </div>
          <div class="col-md-4 d-grid">
            <button class="btn btn-primary" type="submit">
              Subir Excel
            </button>
          </div>
        </form>
      </div>
    </div>

  </header>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>